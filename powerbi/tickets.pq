let
 Source=Csv.Document(Binary.FromText("",BinaryEncoding.Base64),[Delimiter=",",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),
 Headers=Table.PromoteHeaders(Source,[PromoteAllScalars=true]),
 Nulls=Table.ReplaceValue(Headers,"",null,Replacer.ReplaceValue,Table.ColumnNames(Headers)),
 Typed=Table.TransformColumnTypes(Nulls,{{"ticket_id",type text},{"opened_at",type text},{"first_response_at",type text},{"resolved_at",type text},{"team_id",Int64.Type},{"priority",type text},{"channel",type text},{"csat",Int64.Type},{"updated_at",type text},{"response_sla_hours",Int64.Type},{"resolution_sla_hours",Int64.Type},{"month",type text},{"age_hours",type number},{"response_hours",type number},{"resolution_hours",type number},{"response_eligible",Int64.Type},{"response_breach",Int64.Type},{"resolution_eligible",Int64.Type},{"resolution_breach",Int64.Type},{"open_flag",Int64.Type},{"overdue_open",Int64.Type},{"csat_positive",Int64.Type},{"csat_responded",Int64.Type},{"age_band",type text}},"en-US")
in Typed